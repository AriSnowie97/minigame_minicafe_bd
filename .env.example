# Скопіюй цей файл як .env (у папку з грою або поруч з MiniCafe.exe)
# і встав ПУБЛІЧНУ адресу бази Railway.
# Copy this file as .env (next to the game / MiniCafe.exe) and paste the PUBLIC Railway DB URL.
#
# Railway: сервіс Postgres -> Variables -> DATABASE_PUBLIC_URL (хост *.proxy.rlwy.net).
# Внутрішня адреса postgres.railway.internal з комп'ютера не працює.

DATABASE_URL=postgresql://postgres:password@xxxx.proxy.rlwy.net:12345/railway
